# =====================================================================
#  SH SERVICIOS · .htaccess de la raíz
#
#  El proyecto ya NO usa la subcarpeta /public: esta carpeta es a la vez
#  la raíz del proyecto y la raíz web. Subí TODO el contenido a la
#  carpeta pública del hosting (htdocs / public_html / www).
#
#  Sirve para:
#    · XAMPP:        http://localhost/sh-servicios/
#    · InfinityFree / Hostinger / cPanel con el proyecto en la raíz del
#      dominio.
#
#  En un VPS, si podés, apuntá el DocumentRoot directamente a esta
#  carpeta; el resto sigue igual.
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sin RewriteBase a propósito: así funciona igual en la raíz del
    # dominio o dentro de un subdirectorio (ej. /sh-servicios/ en XAMPP).

    # --- 0. Forzar HTTPS en producción ----------------------------------
    #     Se salta localhost / 127.0.0.1 / *.local (XAMPP corre en HTTP) y
    #     respeta el header del proxy del hosting (X-Forwarded-Proto).
    RewriteCond %{HTTPS}                  off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST}              !^localhost [NC]
    RewriteCond %{HTTP_HOST}              !^127\.0\.0\.1
    RewriteCond %{HTTP_HOST}              !\.local$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # --- 1. El código fuente NUNCA se sirve por HTTP ----------------------
    RewriteRule ^(config|core|app|database|storage|lib)(/.*)?$   - [F,L]
    RewriteRule ^(\.env|\.env\..*|coneccion.*\.php|server\.php)$  - [F,L]
    RewriteRule (^|/)\.(git|env)                                  - [F,L]

    # --- 2. URLs amigables: todo lo que no sea archivo/carpeta real
    #        se atiende desde el front controller --------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [QSA,L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Sin mod_rewrite al menos la portada abre
    DirectoryIndex index.php
</IfModule>

# ---------------------------------------------------------------------
# Segunda barrera (por si mod_rewrite no estuviera disponible)
# ---------------------------------------------------------------------
<FilesMatch "^\.env|^coneccion.*\.php$|^server\.php$|\.(sql|log|ini|md)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------
# Cabeceras de seguridad (refuerzo a las que envía PHP)
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By

    # HSTS: sólo se aplica cuando la respuesta ya viaja por HTTPS, así
    # nunca rompe el acceso local por HTTP (XAMPP).
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# ---------------------------------------------------------------------
# Compresión y caché de estáticos
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Tiempos cortos mientras el sitio está en desarrollo. Antes de
    # publicar, se pueden subir de nuevo (CSS/JS a 1 mes, fuentes a 1 año).
    ExpiresByType text/css                "access plus 1 hour"
    ExpiresByType application/javascript  "access plus 1 hour"
    ExpiresByType image/jpeg              "access plus 7 days"
    ExpiresByType image/png               "access plus 7 days"
    ExpiresByType image/webp             "access plus 7 days"
    ExpiresByType image/svg+xml           "access plus 7 days"
    ExpiresByType font/woff2              "access plus 7 days"
</IfModule>

Options -Indexes -MultiViews
