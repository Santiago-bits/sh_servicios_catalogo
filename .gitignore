# Configuración local (nunca se versiona)
.env

# Archivos generados
/storage/logs/*
/storage/cache/*
/storage/pdf/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
!/storage/pdf/.gitkeep

# Archivos subidos por el usuario
/uploads/*
!/uploads/.htaccess
!/uploads/*/.gitkeep

# Conexión con credenciales reales (subir sólo coneccion.example.php)
coneccion.php

# Volcados de base y paquetes de deploy: llevan datos de clientes y/o
# credenciales, nunca se versionan.
*.sql
*.zip
/sh-servicios-hostinger*

# Lockfile del catálogo de skills de ECC (no es parte de la app)
skills-lock.json

# Sistema operativo / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
