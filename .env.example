# =====================================================================
#  SH SERVICIOS · Configuración de entorno
#  Copiá este archivo como  .env  y ajustá los valores.
#  NUNCA subas el archivo .env a un repositorio.
# =====================================================================

# Entorno: local | production
APP_ENV=local

# Mostrar errores en pantalla (1 solo en desarrollo)
APP_DEBUG=1

# Nombre corto de la aplicación
APP_NAME="SH Servicios"

# Zona horaria
APP_TIMEZONE=America/Argentina/Buenos_Aires

# URL pública. Dejalo vacío para autodetección (recomendado en XAMPP).
# Ej: http://localhost/sh-servicios
APP_URL=

# Clave usada para firmar tokens y hashear IPs. Cambiala por una cadena
# larga y aleatoria antes de publicar el sitio.
APP_KEY=cambiar-esta-clave-por-una-cadena-larga-y-aleatoria

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
# La conexión a MySQL ahora se configura en  coneccion.php  (raíz del
# proyecto), que tiene dos apartados: uno para localhost/XAMPP y otro
# para InfinityFree, y elige el correcto según el dominio.
# Estas variables DB_* quedan sólo como referencia; ya no se leen.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sh_servicios
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------
# Sesión y seguridad
# ---------------------------------------------------------------------
SESSION_NAME=shs_session
SESSION_LIFETIME=120
# 1 solo si el sitio corre bajo HTTPS
SESSION_SECURE=0

# Intentos de login fallidos antes de bloquear temporalmente la cuenta
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------------------------------------------------------------------
# Envío de correo
#
# MAIL_MAILER admite:
#   log   → guarda el correo en storage/logs/emails.log (por defecto, ideal
#           para XAMPP y para hostings que no permiten enviar)
#   mail  → función mail() de PHP (no funciona en hosting gratuito)
#   smtp  → servidor SMTP propio (necesita el puerto 587 abierto; los
#           hostings gratuitos suelen bloquearlo)
#   api   → Brevo o SendGrid por HTTPS. Es lo ÚNICO que funciona en
#           hostings gratuitos tipo InfinityFree. Ambos tienen plan gratis.
# ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@shservicios.com.ar
MAIL_FROM_NAME="SH Servicios"

# --- Para MAIL_MAILER=smtp ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# --- Para MAIL_MAILER=api ---
# provider: brevo (300 correos/día gratis) | sendgrid
# Importante: el remitente (MAIL_FROM_ADDRESS) tiene que estar verificado
# en la cuenta del servicio, si no rechaza el envío.
MAIL_API_PROVIDER=brevo
MAIL_API_KEY=

# ---------------------------------------------------------------------
# Subida de archivos
# ---------------------------------------------------------------------
UPLOAD_MAX_MB=8
UPLOAD_MAX_MB_DOC=15
